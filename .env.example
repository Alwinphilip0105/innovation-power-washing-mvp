# ---------------------------------------------------------------------------
# Innovation Power Washing platform - environment configuration
#
# EVERY VALUE HERE IS OPTIONAL. With an empty .env.local the app runs end to
# end on mock providers and an in-memory database:
#
#     npm install && npm run dev
#
# Copy this file to .env.local and fill in only what you actually want to
# switch on. .env* is gitignored - never commit a real key.
# ---------------------------------------------------------------------------

# --- App ---------------------------------------------------------------------
# Absolute base URL. Used for canonical metadata, the sitemap, and the
# dashboard links inside owner notification emails.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# debug | info | warn | error   (default: debug in dev, info in production)
LOG_LEVEL=debug


# --- Data store --------------------------------------------------------------
# memory   - seeded demo dataset, per process, nothing persists (default)
# supabase - Postgres, requires the URL + service role key below
#
# Leave unset to auto-detect: supabase when a service role key is present,
# memory otherwise.
# DATA_STORE=memory

# SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable / anon key. Safe to expose to the browser.
# SUPABASE_ANON_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# SERVER ONLY. Bypasses RLS - never expose this to the browser and never
# prefix it with NEXT_PUBLIC_. Required for DATA_STORE=supabase.
# SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string. Not used by the app at runtime; handy for
# psql and for running the migrations by hand.
# DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres


# --- Authentication ----------------------------------------------------------
# dev      - signed-cookie sign-in against the seeded user (local demo)
# supabase - Supabase Auth; users must exist and map to users.auth_user_id
#
# Leave unset to auto-detect: supabase when its URL + anon key are present.
# Set explicitly to keep the dev sign-in while using Supabase for data.
# AUTH_PROVIDER=dev

# Signs the session cookie. REQUIRED IN PRODUCTION. Without it a random
# per-process secret is generated and every restart signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=

# Credentials for the dev sign-in. Defaults to the seeded owner account:
#   owner@innovationpowerwashing.com / powerwash2026
# DEV_AUTH_EMAIL=
# DEV_AUTH_PASSWORD=


# --- AI assistant ------------------------------------------------------------
# mock      - deterministic assistant, drives the same tools, no API key (default)
# anthropic - Claude via @anthropic-ai/sdk, requires LLM_API_KEY
# AI_PROVIDER=mock
# LLM_API_KEY=
# LLM_MODEL=claude-opus-5


# --- SMS ---------------------------------------------------------------------
# mock   - logs the message and records it on the conversation (default)
# twilio - real delivery; SMS_PROVIDER_API_KEY is ACCOUNT_SID:AUTH_TOKEN
# SMS_PROVIDER=mock
# SMS_PROVIDER_API_KEY=
# SMS_PHONE_NUMBER=

# Shared secret for the inbound webhook HMAC. When unset, signature
# verification is skipped - acceptable locally, required in production.
# SMS_WEBHOOK_SECRET=


# --- Voice -------------------------------------------------------------------
# mock | vapi | retell | twilio
# Only `mock` is implemented in this build. The others are declared adapter
# seats that fail loudly rather than silently dropping a call.
# VOICE_PROVIDER=mock
# VOICE_PROVIDER_API_KEY=
# VOICE_PHONE_NUMBER=
# VOICE_WEBHOOK_SECRET=


# --- Email -------------------------------------------------------------------
# mock   - captured in the dashboard outbox at /dashboard/settings (default)
# resend - real delivery
# EMAIL_PROVIDER=mock
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM=notifications@yourdomain.com


# --- Booking / calendar ------------------------------------------------------
# internal - our own calendar is the source of truth (default)
# google | calcom | calendly - declared adapter seats, not implemented here
# BOOKING_PROVIDER=internal
# BOOKING_PROVIDER_API_KEY=
